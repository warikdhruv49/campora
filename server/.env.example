# Server
PORT=5000
NODE_ENV=development

# MySQL connection (Aiven / Railway / PlanetScale-style managed MySQL also works)
DATABASE_URL="mysql://root:password@localhost:3306/campora"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed frontend origins
CLIENT_URL="http://localhost:5173"
