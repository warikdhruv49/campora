# Base URL of the REST API.
# Leave empty in development (Vite proxies /api to the backend).
# In production set e.g. VITE_API_URL=https://campora-api.onrender.com/api
VITE_API_URL=

# Google OAuth client ID (same as server GOOGLE_CLIENT_ID).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
