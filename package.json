{
  "name": "campora",
  "version": "1.0.0",
  "private": true,
  "description": "CAMPORA - Personal finance command center",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "db:migrate": "npm run prisma:migrate --prefix server",
    "db:seed": "npm run prisma:seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
